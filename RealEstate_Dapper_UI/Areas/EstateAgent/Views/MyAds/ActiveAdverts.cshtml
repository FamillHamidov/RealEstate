@model List<RealEstate_Dapper_UI.Dtos.ProductDtos.ResultProductAdsListWithCategoryByEmployeeDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/EstateAgent/Views/EstateAgentLayout/Index.cshtml";
    int count = 0;
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Product Table</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Title</th>
                                <th scope="col">City</th>
                                <th scope="col">District</th>
                                <th scope="col">Price</th>
                                <th scope="col">Type</th>
                                <th scope="col">Delete</th>
                                <th scope="col">Update</th>
                                <th scope="col">Change Passive</th>
                                <th scope="col">View Site</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.Title</td>
                                    <td>@item.City</td>
                                    <td>@item.District</td>
                                    <td>@item.Price</td>
                                    <td>@item.Type</td>
                                    <td><a href="/Product/DeleteCategory/" class="btn btn-outline-danger">Delete</a></td>
                                    <td><a href="/Product/UpdateCategory/" class="btn btn-outline-success">Update</a></td>
                                    <td><a href="#" class="btn btn-outline-dark">Change Passive</a></td>
                                    <td><a href="/Product/ProductDetail/" class="btn btn-outline-info">View Site</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/EstateAgent/MyAds/CreateProduct" class="btn btn-outline-primary">New Product</a>
                </div>
            </div>
        </div>
    </div>
</div>