@model UpdateWhoWeAreDetailDto
@{
    ViewData["Title"] = "UpdateWhoWeAre";
    Layout = "~/Views/Admin/Index.cshtml";
}
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Update Who We Are</h6>
                <form method="post" class="form-group">
                    <input type="hidden" asp-for="Id" />
                    <label>Title</label>
                    <input asp-for="Title" type="text" class="form-control" />
                    <br />
                    <label>Subtitle</label>
                    <input asp-for="Subtitle" type="text" class="form-control" />
                    <br />
                    <label>Description 1</label>
                    <textarea asp-for="Description1" class="form-control" rows="5"></textarea>
                    <br />
                    <label>Description 2</label>
                    <textarea asp-for="Description2" class="form-control" rows="5"></textarea>
                    <br />
                    <button class="btn btn-primary">Update</button>
                </form>
            </div>
        </div>
    </div>
</div>

