@model CreatePopularLocationDto
@{
    ViewData["Title"] = "CreatePopularLocation";
    Layout = "~/Views/Admin/Index.cshtml";
}
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Create Popular Location</h6>
                <form method="post" class="form-group">
                    <label>City Name</label>
                    <input asp-for="CityName" type="text" class="form-control" placeholder="Please enter city name" />
                    <br />
                    <label>Image Url</label>
                    <input asp-for="ImageUrl" type="text" class="form-control" placeholder="Please enter image url" />
                    <br />
                    <button class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

