@model CreateBottomGridDto
@{
    ViewData["Title"] = "CreateBottomGrid";
    Layout = "~/Views/Admin/Index.cshtml";
}
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Create Bottom Grid</h6>
                <form method="post" class="form-group">
                    <label>Icon</label>
                    <input asp-for="Icon" type="text" class="form-control" placeholder="Please enter Icon" />
                    <br />
                    <label>Title</label>
                    <input asp-for="Title" type="text" class="form-control" placeholder="Please enter title" />
                    <br />
                    <label>Description</label>
                    <input asp-for="Description" type="text" class="form-control" placeholder="Please enter desscription" />
                    <br />
                    <button class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

