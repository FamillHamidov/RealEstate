@model CreateEmployeeDto
@{
    ViewData["Title"] = "CreateEmployee";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Create Employee</h6>
                <form method="post" class="form-group">
                    <label>Employee Name</label>
                    <input asp-for="Name" type="text" class="form-control" placeholder="Please enter employee name" />
                    <br />
                    <label>Title</label>
                    <input asp-for="Title" type="text" class="form-control" placeholder="Please enter title" />
                    <br />
                    <label>Mail</label>
                    <input asp-for="Mail" type="email" class="form-control" placeholder="Please enter mail" />
                    <br />
                    <label>Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Please enter phone number" />
                    <br />
                    <label>Image Url</label>
                    <input asp-for="ImageUrl" type="text" class="form-control" placeholder="Please enter image url" />
                    <br />
                    <input asp-for="Name" type="hidden" value="true"/>
                    <br />
                    <button class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

